# Hosted Supabase Postgres. Prefer the Session pooler URI for cloud hosts
# (Render) — direct db.*.supabase.co is often IPv6-only and unreachable there.
# SSL (sslmode=require) is applied automatically for non-localhost hosts.
DATABASE_URL=postgresql+psycopg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
# Direct (local/dev machines that support IPv6):
# DATABASE_URL=postgresql+psycopg://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

SECRET_KEY=dev-secret-change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_HOURS=24
CORS_ORIGINS=http://localhost:5173,https://YOUR_VERCEL_PROD_ORIGIN
